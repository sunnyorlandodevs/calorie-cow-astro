---
import { SITE, APP_STORE_URL, WAITLIST_URL, withBase } from '../config';
const year = new Date().getFullYear();
const isLive = APP_STORE_URL != null;
// Before launch the waitlist is the CTA; after launch the App Store link is.
const showWaitlist = !isLive && WAITLIST_URL != null;
---

<footer>
  <div class="footer-inner">
    <h2 class="footer-cta">Ready to start cownting?</h2>
    <p class="footer-lede">
      {showWaitlist
        ? "Calorie Cownter is a small, independent app, and it's almost ready. Leave your email and I'll tell you the day it's out."
        : "Calorie Cownter is a small, independent app. If something's broken or you have an idea, I'd love to hear it."}
    </p>

    <div class="footer-actions">
      {showWaitlist && (
        <a class="waitlist" href={WAITLIST_URL} target="_blank" rel="noopener">
          Join the waitlist
          <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M8.5 3.5L13 8l-4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </a>
      )}
      {isLive ? (
        <a class="appstore" href={APP_STORE_URL}>
          <span class="appstore-top">Download on the</span>
          <span class="appstore-bottom">App Store</span>
        </a>
      ) : (
        /* TODO(launch): set APP_STORE_URL in src/config.ts to turn this badge
           into a real link. Until then it is a non-clickable "Coming soon". */
        <span class="appstore is-soon" aria-disabled="true">
          <span class="appstore-top">Coming soon to the</span>
          <span class="appstore-bottom">App Store</span>
        </span>
      )}
      <a class="footer-email" href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </div>

    <div class="footer-base">
      <span>Made with care in Orlando 🐄</span>
      <span class="footer-base-links">
        <a href={withBase('/privacy')}>Privacy</a>
        <a href={withBase('/terms')}>Terms</a>
        <span>© {year} Calorie Cownter</span>
      </span>
    </div>
  </div>
</footer>

<style>
  footer {
    background: var(--dark);
    color: var(--on-dark);
  }
  .footer-inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 88px var(--gutter) 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .footer-cta {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: clamp(34px, 5vw, 56px);
    line-height: 1.04;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .footer-lede {
    margin: 18px 0 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--on-dark-2);
    max-width: 44ch;
    text-wrap: pretty;
  }
  .footer-actions {
    margin-top: 30px;
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .appstore {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    background: var(--on-dark);
    color: var(--dark);
    text-decoration: none;
    padding: 12px 26px;
    border-radius: 14px;
    line-height: 1.15;
  }
  .appstore-top { font-size: 11px; }
  .appstore-bottom { font-family: var(--font-sans); font-weight: 800; font-size: 21px; }
  .appstore.is-soon {
    background: transparent;
    color: var(--on-dark);
    border: 1.5px solid rgba(255, 255, 255, 0.28);
    cursor: default;
  }
  .appstore.is-soon .appstore-top { color: var(--on-dark-muted); }
  .waitlist {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    background: var(--on-dark);
    color: var(--dark);
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 17px;
    padding: 17px 28px;
    border-radius: 14px;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .waitlist:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 26px rgba(0, 0, 0, 0.3);
  }
  .waitlist svg { flex: none; }
  .footer-email {
    color: var(--tan);
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
    border-bottom: 1px solid var(--tan);
  }
  .footer-email:hover { color: var(--on-dark); }
  .footer-base {
    margin-top: 64px;
    width: 100%;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 22px 0 28px;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--on-dark-muted);
  }
  .footer-base-links { display: inline-flex; gap: 20px; }
  .footer-base-links a {
    color: var(--on-dark-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .footer-base-links a:hover { color: var(--on-dark); }
  @media (max-width: 560px) {
    .footer-base { flex-direction: column; text-align: center; align-items: center; }
    .footer-base-links { justify-content: center; flex-wrap: wrap; }
  }
</style>
