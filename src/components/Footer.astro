---
import { SITE, APP_STORE_URL } from '../config';
const year = new Date().getFullYear();
const isLive = APP_STORE_URL != null;
---

<footer>
  <div class="footer-inner">
    <h2 class="footer-cta">Ready to start cownting?</h2>
    <p class="footer-lede">
      Calorie Cownter is a small, independent app. If something's broken or you
      have an idea, I'd love to hear it.
    </p>

    <div class="footer-actions">
      {isLive ? (
        <a class="appstore" href={APP_STORE_URL}>
          <span class="appstore-top">Download on the</span>
          <span class="appstore-bottom">App Store</span>
        </a>
      ) : (
        /* TODO(launch): set APP_STORE_URL in src/config.ts to turn this badge
           into a real link. Until then it is a non-clickable "Coming soon". */
        <span class="appstore is-soon" aria-disabled="true">
          <span class="appstore-top">Coming soon to the</span>
          <span class="appstore-bottom">App Store</span>
        </span>
      )}
      <a class="footer-email" href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </div>

    <div class="footer-base">
      <span>Made with care in Orlando 🐄</span>
      <span class="footer-base-links">
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <span>© {year} Calorie Cownter</span>
      </span>
    </div>
  </div>
</footer>

<style>
  footer {
    background: var(--dark);
    color: var(--on-dark);
  }
  .footer-inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 88px var(--gutter) 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .footer-cta {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: clamp(34px, 5vw, 56px);
    line-height: 1.04;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .footer-lede {
    margin: 18px 0 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--on-dark-2);
    max-width: 44ch;
    text-wrap: pretty;
  }
  .footer-actions {
    margin-top: 30px;
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .appstore {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    background: var(--on-dark);
    color: var(--dark);
    text-decoration: none;
    padding: 12px 26px;
    border-radius: 14px;
    line-height: 1.15;
  }
  .appstore-top { font-size: 11px; }
  .appstore-bottom { font-family: var(--font-sans); font-weight: 800; font-size: 21px; }
  .appstore.is-soon {
    background: transparent;
    color: var(--on-dark);
    border: 1.5px solid rgba(255, 255, 255, 0.28);
    cursor: default;
  }
  .appstore.is-soon .appstore-top { color: var(--on-dark-muted); }
  .footer-email {
    color: var(--tan);
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
    border-bottom: 1px solid var(--tan);
  }
  .footer-email:hover { color: var(--on-dark); }
  .footer-base {
    margin-top: 64px;
    width: 100%;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 22px 0 28px;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--on-dark-muted);
  }
  .footer-base-links { display: inline-flex; gap: 20px; }
  .footer-base-links a {
    color: var(--on-dark-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .footer-base-links a:hover { color: var(--on-dark); }
  @media (max-width: 560px) {
    .footer-base { flex-direction: column; text-align: center; align-items: center; }
    .footer-base-links { justify-content: center; flex-wrap: wrap; }
  }
</style>
