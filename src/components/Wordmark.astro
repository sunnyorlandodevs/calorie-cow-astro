---
// Brand lockup for Calorie Cownter: the real app icon + wordmark. The badge
// image is public/favicon.svg, generated from the app-icon source art by
// scripts/generate-icons.mjs.
import { withBase } from '../config';

interface Props {
  /** When true, use light text (for use on the dark footer). */
  onDark?: boolean;
  href?: string | null;
}
const { onDark = false, href = withBase('/') } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag class:list={['wordmark', { 'on-dark': onDark }]} href={href ?? undefined}>
  <img class="wm-badge" src={withBase('/favicon.svg')} alt="" width="34" height="34" />
  <span class="wm-text">Calorie </span> <span class="wm-accent">Cownter</span>
</Tag>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 20px;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .wordmark.on-dark { color: var(--on-dark); }
  .wm-badge {
    width: 34px;
    height: 34px;
    display: block;
  }
  .wm-text { display: inline-flex; gap: 0; }
  .wm-accent { color: var(--action); margin-left: -4px; }
  .on-dark .wm-accent { color: var(--tan); }

  /* On the narrowest phones the nav row (lockup + CTA + menu button) runs past
     the screen at full size, so step the lockup down rather than let the page
     scroll sideways. */
  @media (max-width: 430px) {
    .wordmark { font-size: 17px; gap: 8px; }
    .wm-badge { width: 29px; height: 29px; }
  }
  @media (max-width: 380px) {
    .wordmark { font-size: 15px; gap: 7px; }
    .wm-badge { width: 26px; height: 26px; }
  }
</style>
