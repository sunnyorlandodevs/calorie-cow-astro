---
// Brand lockup for Calorie Cownter: a rounded cow badge + wordmark, matching
// the Claude Design landing page. TODO(launch): the 🐄 badge is a stand-in for
// the real app icon — swap the badge contents for an <img>/SVG mark when ready.
import { withBase } from '../config';

interface Props {
  /** When true, use light text (for use on the dark footer). */
  onDark?: boolean;
  href?: string | null;
}
const { onDark = false, href = withBase('/') } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag class:list={['wordmark', { 'on-dark': onDark }]} href={href ?? undefined}>
  <span class="wm-badge" aria-hidden="true">🐄</span>
  <span class="wm-text">Calorie <span class="wm-accent">Cownter</span></span>
</Tag>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 20px;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .wordmark.on-dark { color: var(--on-dark); }
  .wm-badge {
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: var(--action);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 17px;
    line-height: 1;
  }
  .wm-text { display: inline-flex; gap: 0; }
  .wm-accent { color: var(--action); margin-left: -4px; }
  .on-dark .wm-accent { color: var(--tan); }
</style>
