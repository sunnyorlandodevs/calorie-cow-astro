---
import Wordmark from './Wordmark.astro';
import { withBase } from '../config';
// Links use root-anchored hrefs (/#features) so they also work from the
// legal pages, jumping back to the landing sections.
const links = [
  { label: 'Features', href: withBase('/#features') },
  { label: 'A look inside', href: withBase('/#look') },
  { label: 'How it works', href: withBase('/#how') },
  { label: 'FAQ', href: withBase('/#faq') },
];
---

<nav>
  <div class="nav-inner">
    <Wordmark href={withBase('/')} />
    <div class="nav-links">
      {links.map(({ label, href }) => <a href={href}>{label}</a>)}
      <a class="nav-cta" href={withBase('/#get')}>Get the app</a>
    </div>
  </div>
</nav>

<style>
  nav {
    background: var(--bg);
  }
  .nav-inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 26px var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .nav-links {
    display: inline-flex;
    align-items: center;
    gap: 26px;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .nav-links a {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .nav-links a:hover { color: var(--action); }
  .nav-cta {
    background: var(--action);
    color: #fff !important;
    border-radius: 999px;
    padding: 9px 18px;
    letter-spacing: 0.06em;
  }
  .nav-cta:hover { background: var(--deep); }
  @media (max-width: 560px) {
    .nav-links { gap: 16px; font-size: 11px; }
  }
</style>
