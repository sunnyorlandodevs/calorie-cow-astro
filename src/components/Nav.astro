---
import Wordmark from './Wordmark.astro';
import { APP_STORE_URL, WAITLIST_URL, withBase } from '../config';
// Before launch the nav CTA goes straight to the waitlist form; after launch it
// jumps to the hero's App Store badge as before.
const showWaitlist = APP_STORE_URL == null && WAITLIST_URL != null;
// Links use root-anchored hrefs (/#features) so they also work from the
// legal pages, jumping back to the landing sections.
const links = [
  { label: 'Features', href: withBase('/#features') },
  { label: 'A look inside', href: withBase('/#look') },
  { label: 'How it works', href: withBase('/#how') },
  { label: 'FAQ', href: withBase('/#faq') },
];
---

<nav>
  <div class="nav-inner">
    <Wordmark href={withBase('/')} />
    <div class="nav-links">
      {links.map(({ label, href }) => <a href={href}>{label}</a>)}
      {showWaitlist ? (
        <a class="nav-cta" href={WAITLIST_URL} target="_blank" rel="noopener">
          <span class="nav-cta-full">Join the waitlist</span>
          <span class="nav-cta-short">Waitlist</span>
        </a>
      ) : (
        <a class="nav-cta" href={withBase('/#get')}>Get the app</a>
      )}
    </div>
  </div>
</nav>

<style>
  nav {
    background: var(--bg);
  }
  .nav-inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 26px var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .nav-links {
    display: inline-flex;
    align-items: center;
    gap: 26px;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .nav-links a {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .nav-links a:hover { color: var(--action); }
  .nav-cta {
    background: var(--action);
    color: #fff !important;
    border-radius: 999px;
    padding: 9px 18px;
    letter-spacing: 0.06em;
  }
  .nav-cta:hover { background: var(--deep); }
  .nav-cta { white-space: nowrap; }
  /* The full label wraps inside the pill on narrow screens — swap in a short one. */
  .nav-cta-short { display: none; }
  @media (max-width: 560px) {
    .nav-links { gap: 16px; font-size: 11px; }
    .nav-cta-full { display: none; }
    .nav-cta-short { display: inline; }
  }
</style>
