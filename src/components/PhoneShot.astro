---
/**
 * A real app screenshot inside a device bezel, click to enlarge.
 *
 * The screenshots in src/assets/screenshots/ are captured at device resolution
 * and already include the iOS status bar, so the frame here is just the bezel —
 * no fake chrome, no simulated notch drawn on top of the image.
 *
 * Astro's <Image> handles the downscale + webp conversion at build time; pass
 * `width` in CSS pixels and it emits a 2x-ready asset. The enlarged copy is a
 * second, bigger rendition that browsers only fetch once the popover opens,
 * since a closed popover is display:none.
 *
 * The lightbox is the native popover API: no JavaScript, and Esc plus
 * click-outside come for free. Browsers without it fall back to no zoom (see
 * the @supports rule) rather than dumping the panel into the page.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Rendered width of the device in CSS px. Bezel scales with it. */
  width?: number;
  /** iPad captures are landscape and need a thinner, less rounded bezel. */
  device?: 'phone' | 'pad';
  /** Short caption under the frame, for shots shown in a strip ("Day", "Week"). */
  label?: string;
  /** Skip the lazy-load default for the hero shot (it's above the fold). */
  eager?: boolean;
  /** Only needed if the same screenshot is used twice on one page. */
  id?: string;
  /** Set by ShotStrip so the enlarged view can step through the group. */
  prevId?: string;
  nextId?: string;
  /** e.g. "2 of 3", announced next to the arrows. */
  position?: string;
  class?: string;
}

const {
  src,
  alt,
  width = 264,
  device = 'phone',
  label,
  eager = false,
  id,
  prevId,
  nextId,
  position,
  class: className,
} = Astro.props;

// Bezel proportions, tuned to read as a modern iPhone / iPad at any width.
const ratio = device === 'pad' ? { pad: 0.024, radius: 0.055 } : { pad: 0.042, radius: 0.167 };
const pad = Math.max(3, Math.round(width * ratio.pad));
const outerRadius = Math.round(width * ratio.radius);
const innerRadius = Math.max(2, outerRadius - pad);

// One popover per shot. The built asset path carries a content hash, so it is
// unique per image — pass `id` if you ever reuse one screenshot on a page.
const popId = id ?? `shot-${src.src.replace(/[^a-zA-Z0-9]/g, '').slice(-24)}`;

// Big enough to stay sharp when blown up to most of the viewport.
const zoomWidth = device === 'pad' ? 1400 : 760;
---

<figure class:list={['shot', className]} style={`width:${width}px`}>
  <button class="shot-trigger" popovertarget={popId} style={`border-radius:${outerRadius}px`}>
    <span class="phone" style={`padding:${pad}px;border-radius:${outerRadius}px`}>
      <Image
        class="phone-screen"
        src={src}
        alt={alt}
        width={width * 2}
        loading={eager ? 'eager' : 'lazy'}
        style={`border-radius:${innerRadius}px`}
      />
    </span>
    <span class="shot-zoom" aria-hidden="true">
      <svg width="15" height="15" viewBox="0 0 16 16" fill="none"><circle cx="7" cy="7" r="4.6" stroke="currentColor" stroke-width="1.7"></circle><path d="M10.4 10.4L14 14M7 5.2v3.6M5.2 7h3.6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path></svg>
    </span>
  </button>
  {label && <figcaption class="shot-label">{label}</figcaption>}
</figure>

<div class="lightbox" id={popId} popover>
  <Image class="lightbox-img" src={src} alt={alt} width={zoomWidth} loading="lazy" />

  {/* Opening another auto popover closes this one, so stepping through a group
      needs no script — the arrow just points at the neighbour's id. */}
  {prevId && (
    <button class="lightbox-nav lightbox-prev" popovertarget={prevId} aria-label="Previous screenshot">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M12.5 4L6.5 10l6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </button>
  )}
  {nextId && (
    <button class="lightbox-nav lightbox-next" popovertarget={nextId} aria-label="Next screenshot">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M7.5 4l6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </button>
  )}
  {position && <p class="lightbox-count">{label ? `${label} · ${position}` : position}</p>}

  <button
    class="lightbox-close"
    popovertarget={popId}
    popovertargetaction="hide"
    aria-label="Close"
  >
    <svg width="17" height="17" viewBox="0 0 18 18" fill="none"><path d="M4 4l10 10M14 4L4 14" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path></svg>
  </button>
</div>

<style>
  .shot {
    margin: 0;
    /* The inline width is a target, not a floor — a wide shot (the iPad one)
       must still fit a phone screen. */
    max-width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .shot-trigger {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
    transition: transform 0.2s ease;
  }
  .shot-trigger:hover { transform: translateY(-3px); }
  .shot-trigger:focus-visible {
    outline: 2px solid var(--action);
    outline-offset: 6px;
  }

  .phone {
    position: relative;
    display: block;
    width: 100%;
    background: #0f0d0b;
    /* Kept light on purpose: two soft, low-opacity layers read as depth,
       where one heavy layer reads as a grey box behind the phone. */
    box-shadow:
      0 2px 6px rgba(45, 32, 18, 0.08),
      0 14px 30px rgba(45, 32, 18, 0.11),
      inset 0 2px 0 rgba(255, 255, 255, 0.06);
  }
  .phone-screen {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Hint that the shot opens. Always visible on touch, where there's no hover. */
  .shot-zoom {
    position: absolute;
    right: 10px;
    bottom: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgba(15, 13, 11, 0.72);
    color: #fff;
    opacity: 0;
    transform: scale(0.9);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .shot-trigger:hover .shot-zoom,
  .shot-trigger:focus-visible .shot-zoom { opacity: 1; transform: scale(1); }
  @media (hover: none) {
    .shot-zoom { opacity: 0.85; transform: none; }
  }

  .shot-label {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* ---------- lightbox ---------- */
  .lightbox {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: none;
    background: none;
    overflow: visible;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lightbox:not(:popover-open) { display: none; }
  .lightbox::backdrop {
    background: rgba(20, 16, 12, 0.82);
    backdrop-filter: blur(3px);
  }
  .lightbox-img {
    max-width: 92vw;
    max-height: 88vh;
    width: auto;
    height: auto;
    border-radius: 22px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
  }
  .lightbox-close,
  .lightbox-nav {
    position: fixed;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.14);
    color: #f4ede4;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .lightbox-close:hover,
  .lightbox-nav:hover { background: rgba(255, 255, 255, 0.28); }
  .lightbox-close:focus-visible,
  .lightbox-nav:focus-visible {
    outline: 2px solid #f4ede4;
    outline-offset: 3px;
  }
  .lightbox-close {
    top: 18px;
    right: 18px;
    width: 42px;
    height: 42px;
  }
  .lightbox-nav {
    top: 50%;
    transform: translateY(-50%);
    width: 52px;
    height: 52px;
  }
  .lightbox-prev { left: 18px; }
  .lightbox-next { right: 18px; }
  .lightbox-count {
    position: fixed;
    left: 50%;
    bottom: 18px;
    transform: translateX(-50%);
    margin: 0;
    padding: 7px 16px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
    color: #f4ede4;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* On a phone the arrows would sit on top of the image, so drop them to the
     bottom next to the counter, where thumbs are anyway. */
  @media (max-width: 620px) {
    .lightbox-img { max-height: 78vh; }
    .lightbox-nav {
      top: auto;
      bottom: 16px;
      transform: none;
      width: 46px;
      height: 46px;
    }
    .lightbox-prev { left: 22px; }
    .lightbox-next { right: 22px; }
    .lightbox-count { bottom: 27px; }
  }

  /* Fade + lift in. Skipped silently where unsupported. */
  @media (prefers-reduced-motion: no-preference) {
    .lightbox,
    .lightbox::backdrop {
      transition:
        opacity 0.22s ease,
        transform 0.22s ease,
        overlay 0.22s allow-discrete,
        display 0.22s allow-discrete;
    }
    .lightbox { opacity: 0; transform: scale(0.97); }
    .lightbox::backdrop { opacity: 0; }
    .lightbox:popover-open { opacity: 1; transform: scale(1); }
    .lightbox:popover-open::backdrop { opacity: 1; }
    @starting-style {
      .lightbox:popover-open { opacity: 0; transform: scale(0.97); }
      .lightbox:popover-open::backdrop { opacity: 0; }
    }
  }

  /* No popover support: no zoom, and the panel stays out of the page rather
     than rendering inline (the UA rule that hides it doesn't exist there). */
  @supports not selector(:popover-open) {
    [popover] { display: none; }
    .shot-trigger { cursor: default; }
    .shot-zoom { display: none; }
  }
</style>
