---
import BaseLayout from '../layouts/BaseLayout.astro';
import { APP_STORE_URL } from '../config';

// FAQ content — mirrors the verified data flows (photos discarded, iCloud-only
// diary, 3 free AI scans, Sign in with Apple only for AI).
const faqs = [
  {
    q: 'Is it free?',
    a: "Mostly, yes. Logging, barcode scanning, and Apple Health are free with no ads. AI photo scans are free three times a day; an optional subscription for unlimited scans is coming soon.",
  },
  {
    q: 'Do I need an account?',
    a: "No. Open the app and start logging. Sign in with Apple is only needed if you want the free daily AI scans.",
  },
  {
    q: 'Where does my data live?',
    a: "In your own iCloud, synced privately across your devices. We can't see your food diary, and Apple Health values never leave your phone.",
  },
  {
    q: 'What happens to photos I scan?',
    a: "A photo is analyzed to estimate nutrition, then discarded. We don't store it.",
  },
  {
    q: 'When can I get it?',
    a: "It's in pre-beta right now. The App Store badge on this page goes live the moment the app does.",
  },
];
---

<BaseLayout>
  <!-- ============ HERO ============ -->
  <div class="hero">
    <div class="hero-copy">
      <p class="hero-kicker">For iPhone · Pre-beta</p>
      <h1 class="hero-title">Count calories without having a <span>cow</span>.</h1>
      <p class="hero-lede">
        Log a meal in seconds, scan a barcode, or snap a photo and let AI do the
        math. No account, no ads — your food diary lives in your own iCloud, not
        on our servers.
      </p>

      <div id="get" class="hero-cta">
        {APP_STORE_URL ? (
          <a class="appstore appstore-live" href={APP_STORE_URL}>
            <span class="appstore-top">Download on the</span>
            <span class="appstore-bottom">App Store</span>
          </a>
        ) : (
          /* TODO(launch): set APP_STORE_URL in src/config.ts and this becomes a
             real link. Until then it is a non-clickable "Coming soon" badge. */
          <span class="appstore appstore-soon" aria-disabled="true">
            <span class="appstore-top">Coming soon to the</span>
            <span class="appstore-bottom">App Store</span>
          </span>
        )}
        <span class="hero-note">Currently in pre-beta</span>
      </div>

      <div class="hero-points">
        <span><svg width="13" height="13" viewBox="0 0 14 14" fill="none"><path d="M2 7.5L5.5 11 12 3.5" stroke="#664428" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>No account needed</span>
        <span><svg width="13" height="13" viewBox="0 0 14 14" fill="none"><path d="M2 7.5L5.5 11 12 3.5" stroke="#664428" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>No ads, ever</span>
        <span><svg width="13" height="13" viewBox="0 0 14 14" fill="none"><path d="M2 7.5L5.5 11 12 3.5" stroke="#664428" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>Your data stays yours</span>
      </div>
    </div>

    <!-- Illustrative in-app phone mock (not a screenshot). TODO(launch): can be
         replaced with a real device screenshot once the app is captured. -->
    <div class="hero-visual">
      <div class="hero-halo"></div>
      <div class="phone">
        <div class="phone-screen">
          <div class="phone-head"><span class="phone-title">Today</span><span class="phone-date">Jul 20</span></div>
          <div class="phone-ring-wrap">
            <div class="phone-ring">
              <div class="phone-ring-hole"><span class="phone-kcal">1,478</span><span class="phone-kcal-label">kcal left</span></div>
            </div>
          </div>
          <div class="phone-macros">
            <div class="macro"><span class="macro-label">Protein</span><span class="macro-track"><span class="macro-fill" style="width:55%;background:#C7392B"></span></span></div>
            <div class="macro"><span class="macro-label">Carbs</span><span class="macro-track" style="background:#F1E3C4"><span class="macro-fill" style="width:72%;background:#C89018"></span></span></div>
            <div class="macro"><span class="macro-label">Fat</span><span class="macro-track" style="background:#DCE2F5"><span class="macro-fill" style="width:64%;background:#2E57D9"></span></span></div>
          </div>
          <div class="phone-meals">
            <div class="meal"><span class="meal-name">Breakfast</span><span class="meal-kcal">790 kcal</span></div>
            <div class="meal"><span class="meal-name">Lunch</span><span class="meal-kcal">590 kcal</span></div>
            <div class="meal meal-empty"><span class="meal-name">Dinner</span><span class="meal-add">＋ add</span></div>
          </div>
          <div class="phone-activity"><span>🔥 Activity</span><span class="phone-activity-val">+608 kcal earned</span></div>
        </div>
      </div>
    </div>
  </div>

  <!-- ============ FEATURES ============ -->
  <div id="features" class="band-soft">
    <div class="section">
      <p class="kicker">What you get</p>
      <h2 class="h-section h-narrow">Everything you need to log a meal — and nothing you don't.</h2>
      <div class="feature-grid">
        <article class="feature">
          <span class="feature-icon"><svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M13.5 3.5l3 3L7 16H4v-3l9.5-9.5z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path><path d="M11.5 5.5l3 3" stroke="currentColor" stroke-width="1.8"></path></svg></span>
          <h3 class="feature-title">Log anything, fast</h3>
          <p class="feature-body">Breakfast, lunch, dinner, or the 11 pm snack — type it in and it's saved. No sign-up, no setup wizard.</p>
        </article>
        <article class="feature">
          <span class="feature-icon"><svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M2 6V3.5A1.5 1.5 0 0 1 3.5 2H6M14 2h2.5A1.5 1.5 0 0 1 18 3.5V6M18 14v2.5a1.5 1.5 0 0 1-1.5 1.5H14M6 18H3.5A1.5 1.5 0 0 1 2 16.5V14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path><path d="M6 7v6M9.5 7v6M13 7v6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg></span>
          <h3 class="feature-title">Scan a barcode</h3>
          <p class="feature-body">Point your camera at a package and we look it up in the Open Food Facts database. Still no account required.</p>
        </article>
        <article class="feature feature-ai">
          <span class="feature-icon feature-icon-ai"><svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 2l1.8 4.6L16.5 8l-4.7 1.4L10 14l-1.8-4.6L3.5 8l4.7-1.4L10 2z" fill="currentColor"></path><path d="M16 13l.9 2.1L19 16l-2.1.9L16 19l-.9-2.1L13 16l2.1-.9L16 13z" fill="currentColor"></path></svg></span>
          <h3 class="feature-title">Snap a photo, AI does the math</h3>
          <p class="feature-body">Photograph your plate or just describe it — AI estimates the calories and macros. <b>Three free scans a day</b> with Sign in with Apple.</p>
          <span class="feature-soon">Unlimited scans subscription coming soon</span>
        </article>
        <article class="feature">
          <span class="feature-icon"><svg width="20" height="18" viewBox="0 0 20 18" fill="none"><path d="M10 16.5S2 11.5 2 6.4A4.4 4.4 0 0 1 6.4 2C8 2 9.4 2.9 10 4.2 10.6 2.9 12 2 13.6 2A4.4 4.4 0 0 1 18 6.4c0 5.1-8 10.1-8 10.1z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path></svg></span>
          <h3 class="feature-title">Apple Health, earned back</h3>
          <p class="feature-body">Workouts and daily movement raise your calorie budget. Your Health data never leaves your phone.</p>
        </article>
      </div>
    </div>
  </div>

  <!-- ============ HOW IT WORKS ============ -->
  <div id="how" class="section">
    <p class="kicker">How it works</p>
    <h2 class="h-section h-narrower">Three steps. Zero spreadsheets.</h2>
    <div class="steps">
      <div class="step">
        <span class="step-num">01</span>
        <span class="step-title">Log your meals</span>
        <span class="step-body">Type it, scan the barcode, or snap a photo. Whichever is fastest wins.</span>
      </div>
      <div class="step">
        <span class="step-num">02</span>
        <span class="step-title">Earn calories back</span>
        <span class="step-body">A walk, a workout, a busy day — activity from Apple Health adds to your daily budget.</span>
      </div>
      <div class="step">
        <span class="step-num">03</span>
        <span class="step-title">Stay on budget</span>
        <span class="step-body">Watch the ring fill as your day goes. Macro bars keep you honest without the guilt trip.</span>
      </div>
    </div>
  </div>

  <!-- ============ FAQ ============ -->
  <div id="faq" class="band-soft">
    <div class="faq-wrap">
      <p class="kicker">FAQ</p>
      <h2 class="h-section faq-heading">Fair questions.</h2>
      {faqs.map((f, i) => (
        <details name="faq" open={i === 0} class="faq-item">
          <summary>
            <span class="faq-q">{f.q}</span>
            <svg class="faq-ico faq-ico-minus" width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7h10" stroke="#664428" stroke-width="2.2" stroke-linecap="round"></path></svg>
            <svg class="faq-ico faq-ico-plus" width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M7 2v10M2 7h10" stroke="#8A7F6E" stroke-width="2.2" stroke-linecap="round"></path></svg>
          </summary>
          <p class="faq-a">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  /* ---------- HERO ---------- */
  .hero {
    max-width: var(--container);
    margin: 0 auto;
    padding: 44px var(--gutter) 96px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 56px;
  }
  .hero-copy { flex: 1 1 460px; min-width: 0; }
  .hero-kicker {
    margin: 0 0 22px;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--action);
  }
  .hero-title {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: clamp(46px, 6.5vw, 80px);
    line-height: 0.98;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .hero-title span { color: var(--action); }
  .hero-lede {
    margin: 24px 0 0;
    font-size: 19px;
    line-height: 1.6;
    color: var(--ink2);
    max-width: 46ch;
    text-wrap: pretty;
  }
  .hero-cta {
    margin-top: 34px;
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }
  .appstore {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    padding: 12px 26px;
    border-radius: 14px;
    line-height: 1.15;
    text-decoration: none;
  }
  .appstore-top { font-size: 11px; letter-spacing: 0.02em; }
  .appstore-bottom { font-family: var(--font-sans); font-weight: 800; font-size: 21px; }
  .appstore-live { background: var(--dark); color: #f4ede4; }
  .appstore-soon {
    background: var(--surface);
    color: var(--ink);
    border: 1.5px solid var(--rule);
    box-shadow: 0 1px 3px rgba(60, 45, 20, 0.06);
    cursor: default;
  }
  .appstore-soon .appstore-top { color: var(--muted); }
  .hero-note { font-family: var(--font-mono); font-weight: 500; font-size: 13px; color: var(--muted); }
  .hero-points {
    margin-top: 30px;
    display: flex;
    gap: 22px;
    flex-wrap: wrap;
    font-weight: 600;
    font-size: 14px;
    color: var(--ink2);
  }
  .hero-points span { display: inline-flex; align-items: center; gap: 7px; }

  /* ---------- HERO PHONE MOCK ---------- */
  .hero-visual {
    flex: 1 1 400px;
    display: flex;
    justify-content: center;
    position: relative;
    min-width: 300px;
  }
  .hero-halo {
    position: absolute;
    width: 380px;
    height: 380px;
    border-radius: 50%;
    background: var(--soft);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }
  .phone {
    position: relative;
    width: 264px;
    background: #0f0d0b;
    border-radius: 44px;
    padding: 11px;
    box-shadow: 0 30px 60px rgba(30, 20, 10, 0.28), inset 0 2px 0 rgba(255, 255, 255, 0.06);
  }
  .phone-screen {
    border-radius: 34px;
    overflow: hidden;
    background: #f6f2e9;
    padding: 26px 16px 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .phone-head { display: flex; justify-content: space-between; align-items: baseline; }
  .phone-title { font-family: var(--font-sans); font-weight: 800; font-size: 22px; color: #201a12; letter-spacing: -0.02em; }
  .phone-date { font-weight: 600; font-size: 11px; color: #a2988a; }
  .phone-ring-wrap { display: flex; justify-content: center; padding: 4px 0; }
  .phone-ring {
    width: 132px;
    height: 132px;
    border-radius: 50%;
    background: conic-gradient(#6b4e2e 0 62%, #eae1d2 62% 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .phone-ring-hole {
    width: 104px;
    height: 104px;
    border-radius: 50%;
    background: #f6f2e9;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .phone-kcal { font-family: var(--font-sans); font-weight: 800; font-size: 24px; color: #201a12; letter-spacing: -0.02em; }
  .phone-kcal-label { font-weight: 600; font-size: 10.5px; color: #a2988a; }
  .phone-macros { display: flex; flex-direction: column; gap: 7px; }
  .macro { display: flex; align-items: center; gap: 8px; }
  .macro-label { font-weight: 700; font-size: 10px; color: #4a3f32; width: 44px; }
  .macro-track { flex: 1; height: 6px; border-radius: 3px; background: #f4dbd6; }
  .macro-fill { display: block; height: 6px; border-radius: 3px; }
  .phone-meals { background: #fff; border-radius: 16px; padding: 2px 12px; }
  .meal { display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid #efe9dd; }
  .meal:last-child { border-bottom: none; }
  .meal-name { font-weight: 700; font-size: 12.5px; color: #201a12; }
  .meal-kcal { font-weight: 600; font-size: 12px; color: #a2988a; }
  .meal-empty .meal-name { color: #a2988a; }
  .meal-add { font-weight: 600; font-size: 12px; color: #6b4e2e; }
  .phone-activity {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #efe7d9;
    border-radius: 12px;
    padding: 9px 12px;
    font-weight: 700;
    font-size: 11.5px;
    color: #6b4e2e;
  }
  .phone-activity-val { font-weight: 800; }

  /* ---------- SHARED SECTION PRIMITIVES ---------- */
  .band-soft { background: var(--soft); }
  .section {
    max-width: var(--container);
    margin: 0 auto;
    padding: 96px var(--gutter);
  }
  .kicker {
    margin: 0 0 14px;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--action);
  }
  .h-section {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: clamp(32px, 4.5vw, 48px);
    line-height: 1.06;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .h-narrow { max-width: 20ch; }
  .h-narrower { max-width: 16ch; }

  /* ---------- FEATURES ---------- */
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 20px;
    margin-top: 48px;
  }
  .feature {
    background: var(--surface);
    border-radius: 22px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .feature-icon {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: var(--soft);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--action);
  }
  .feature-title { margin: 0; font-family: var(--font-sans); font-weight: 800; font-size: 19px; letter-spacing: -0.01em; }
  .feature-body { margin: 0; font-size: 15px; line-height: 1.6; color: var(--ink2); }
  .feature-ai {
    border: 1.5px solid var(--ai);
    background: linear-gradient(180deg, var(--aisoft), var(--surface) 70%);
  }
  .feature-icon-ai { background: var(--aisoft); color: var(--ai); }
  .feature-soon { font-family: var(--font-mono); font-weight: 500; font-size: 12px; color: var(--ai); }

  /* ---------- HOW IT WORKS ---------- */
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 36px;
    margin-top: 52px;
  }
  .step {
    display: flex;
    flex-direction: column;
    gap: 12px;
    border-top: 2px solid var(--rule);
    padding-top: 20px;
  }
  .step-num { font-family: var(--font-mono); font-weight: 500; font-size: 13px; color: var(--tan); }
  .step-title { font-family: var(--font-sans); font-weight: 800; font-size: 21px; letter-spacing: -0.01em; }
  .step-body { font-size: 15.5px; line-height: 1.6; color: var(--ink2); }

  /* ---------- FAQ ---------- */
  .faq-wrap {
    max-width: 760px;
    margin: 0 auto;
    padding: 96px var(--gutter);
  }
  .faq-heading { margin-bottom: 20px; }
  .faq-item { border-bottom: 1.5px solid var(--rule); }
  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 0;
    cursor: pointer;
    list-style: none;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-q { font-family: var(--font-sans); font-weight: 800; font-size: 17.5px; letter-spacing: -0.01em; }
  .faq-ico { flex: none; }
  .faq-item:not([open]) .faq-ico-minus { display: none; }
  .faq-item[open] .faq-ico-plus { display: none; }
  .faq-a {
    margin: -6px 0 0;
    padding: 0 32px 20px 0;
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--ink2);
  }

  @media (max-width: 860px) {
    .hero { padding-top: 20px; }
    .section { padding: 68px var(--gutter); }
    .faq-wrap { padding: 68px var(--gutter); }
  }
</style>
