---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhoneShot from '../components/PhoneShot.astro';
import { APP_STORE_URL, WAITLIST_URL, PRO } from '../config';

// Real device captures, not mockups. See NOTES in the README for how to refresh
// them (they must be re-shot whenever the app's visual design changes).
import todayShot from '../assets/screenshots/today.png';
import summaryShot from '../assets/screenshots/summary.png';
import summaryDayShot from '../assets/screenshots/summary-day.png';
import summaryMonthShot from '../assets/screenshots/summary-month.png';
import widgetsShot from '../assets/screenshots/widgets.png';
import addFoodShot from '../assets/screenshots/add-food.png';
import mealGroupShot from '../assets/screenshots/meal-group.png';
import themeSettingsShot from '../assets/screenshots/theme-settings.png';
import themeTodayShot from '../assets/screenshots/theme-today.png';
import ipadShot from '../assets/screenshots/ipad.png';

const isLive = APP_STORE_URL != null;
// Before launch the waitlist is the CTA; after launch the App Store link is.
const showWaitlist = !isLive && WAITLIST_URL != null;

// Pro is described without a number until the App Store product is final —
// PRO.price stays null so the site can never contradict Apple's price.
const proLine = PRO.price
  ? `${PRO.name} unlocks unlimited scans for ${PRO.price}, with a ${PRO.trialDays}-day free trial.`
  : `${PRO.name} unlocks unlimited scans.`;

// FAQ content — mirrors the verified data flows (photos discarded, iCloud-only
// diary, 3 free AI scans, Sign in with Apple only for AI).
const faqs = [
  {
    q: 'Is it free?',
    a: `Mostly, yes. Logging, barcode scanning, widgets, and Apple Health are all free, with no ads. AI photo scans are free ${PRO.freeScansPerDay} times a day. ${proLine}. As AI continous to develop, the costs to operate will decrease, and we may adjust the Pro plan accordingly to save you money.`,
  },
  {
    q: 'Do I need an account?',
    a: 'No. Open the app and start logging. Sign in with Apple is only needed if you want the AI photo scans or use the AI description feature.',
  },
  {
    q: 'Where does my data live?',
    a: "In your own iCloud, synced privately across your devices. We can't see your food diary, and Apple Health values never leave your phone.",
  },
  {
    q: 'What happens to photos I scan?',
    a: "A photo is analyzed to estimate nutrition, then discarded. We don't store it.",
  },
  ...(showWaitlist
    ? [
        {
          q: 'When can I get it?',
          a: "Soon — it's finished and going through App Store review. Join the waitlist and you'll get one email the day it's out!",
        },
      ]
    : []),
  {
    q: 'Does it work on iPad?',
    a: 'Yes — iPad gets a layout built for the bigger screen, not a stretched phone app. Everything syncs through your iCloud, so your diary is the same on both.',
  },
  {
    q: 'Is there an Android version?',
    a: "Unfortunately, no, and there aren't any current plans for one. Calorie Cownter leans hard on Apple-only things, such as iCloud sync, Apple Health, widgets, Sign in with Apple. In the future though, once the iOS app is at a stable place, we may explore an Android version.",
  },
];
---

<BaseLayout>
  <!-- ============ HERO ============ -->
  <div class="hero">
    <div class="hero-copy">
      <p class="hero-kicker">For iPhone &amp; iPad</p>
      <h1 class="hero-title">Count calories without having a <span>cow</span>.</h1>
      <p class="hero-lede">
        Download the app and start logging your meals in seconds. No account, no ads. Just a simple food diary that syncs across your devices and keeps your data private.
      </p>

      <div id="get" class="hero-cta">
        {showWaitlist && (
          <a class="waitlist" href={WAITLIST_URL} target="_blank" rel="noopener">
            Join the waitlist
            <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M8.5 3.5L13 8l-4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </a>
        )}
        {isLive ? (
          <a class="appstore appstore-live" href={APP_STORE_URL}>
            <span class="appstore-top">Download on the</span>
            <span class="appstore-bottom">App Store</span>
          </a>
        ) : (
          /* TODO(launch): set APP_STORE_URL in src/config.ts and this becomes a
             real link. Until then it is a non-clickable "Coming soon" badge. */
          <span class="appstore appstore-soon" aria-disabled="true">
            <span class="appstore-top">Coming soon to the</span>
            <span class="appstore-bottom">App Store</span>
          </span>
        )}
      </div>
      {showWaitlist && (
        <p class="hero-note">Join to get notified once it gets to the app store!</p>
      )}

      <div class="hero-points">
        <span><svg width="13" height="13" viewBox="0 0 14 14" fill="none"><path d="M2 7.5L5.5 11 12 3.5" stroke="#664428" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>No account needed</span>
        <span><svg width="13" height="13" viewBox="0 0 14 14" fill="none"><path d="M2 7.5L5.5 11 12 3.5" stroke="#664428" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>No ads, ever</span>
        <span><svg width="13" height="13" viewBox="0 0 14 14" fill="none"><path d="M2 7.5L5.5 11 12 3.5" stroke="#664428" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>Your data stays yours</span>
      </div>
    </div>

    <div class="hero-visual">
      <div class="hero-halo"></div>
      <PhoneShot
        src={todayShot}
        alt="The Calorie Cownter home screen: 2,122 calories left of a 2,852 budget, protein, carbs and fat bars, a strength-training workout that earned 352 calories back, and a logged breakfast."
        width={276}
        eager={true}
      />
    </div>
  </div>

  <!-- ============ FEATURES ============ -->
  <div id="features" class="band-soft">
    <div class="section">
      <p class="kicker">What you get</p>
      <h2 class="h-section h-narrow">Everything you need to log a meal.</h2>
      <div class="feature-grid">
        <article class="feature">
          <span class="feature-icon"><svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M13.5 3.5l3 3L7 16H4v-3l9.5-9.5z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path><path d="M11.5 5.5l3 3" stroke="currentColor" stroke-width="1.8"></path></svg></span>
          <h3 class="feature-title">Log anything, fast</h3>
          <p class="feature-body">Breakfast, lunch, dinner, or the 11 pm snack.</p>
        </article>
        <article class="feature">
          <span class="feature-icon"><svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M2 6V3.5A1.5 1.5 0 0 1 3.5 2H6M14 2h2.5A1.5 1.5 0 0 1 18 3.5V6M18 14v2.5a1.5 1.5 0 0 1-1.5 1.5H14M6 18H3.5A1.5 1.5 0 0 1 2 16.5V14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path><path d="M6 7v6M9.5 7v6M13 7v6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg></span>
          <h3 class="feature-title">Scan a barcode, or search</h3>
          <p class="feature-body">Point your camera at a package, or search a database of over a million foods.</p>
        </article>
        <article class="feature feature-ai">
          <span class="feature-icon feature-icon-ai"><svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 2l1.8 4.6L16.5 8l-4.7 1.4L10 14l-1.8-4.6L3.5 8l4.7-1.4L10 2z" fill="currentColor"></path><path d="M16 13l.9 2.1L19 16l-2.1.9L16 19l-.9-2.1L13 16l2.1-.9L16 13z" fill="currentColor"></path></svg></span>
          <h3 class="feature-title">Snap a photo, AI does the math</h3>
          <p class="feature-body">Photograph your plate or just describe it, our AI will figure out the calories and macros for you. <b>Three free scans a day</b> with Sign in with Apple.</p>
          <span class="feature-pro">{proLine}</span>
        </article>
        <article class="feature">
          <span class="feature-icon"><svg width="20" height="18" viewBox="0 0 20 18" fill="none"><path d="M10 16.5S2 11.5 2 6.4A4.4 4.4 0 0 1 6.4 2C8 2 9.4 2.9 10 4.2 10.6 2.9 12 2 13.6 2A4.4 4.4 0 0 1 18 6.4c0 5.1-8 10.1-8 10.1z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path></svg></span>
          <h3 class="feature-title">Apple Health, earned back</h3>
          <p class="feature-body">Workouts and daily movement raise your calorie budget, and the app shows exactly where the extra came from. Your Health data never leaves your phone.</p>
        </article>
        <article class="feature">
          <span class="feature-icon"><svg width="20" height="20" viewBox="0 0 20 20" fill="none"><rect x="2.5" y="2.5" width="15" height="15" rx="4.5" stroke="currentColor" stroke-width="1.8"></rect><path d="M10 6.5v3.5l2.4 1.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
          <h3 class="feature-title">Widgets that answer the question</h3>
          <p class="feature-body">Calories left, right on your Home Screen and Lock Screen. Most days you won't need to open the app at all.</p>
        </article>
        <article class="feature">
          <span class="feature-icon"><svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 2.5l2.3 4.9 5.2.7-3.8 3.7.9 5.2L10 14.6l-4.6 2.4.9-5.2L2.5 8.1l5.2-.7L10 2.5z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path></svg></span>
          <h3 class="feature-title">Eat it often? Two taps</h3>
          <p class="feature-body">Save favorites and re-log the meals you eat all the time. Recent foods are right there too.</p>
        </article>
      </div>
    </div>
  </div>

  <!-- ============ SCREENSHOT SHOWCASE ============ -->
  <div id="look" class="section">
    <p class="kicker">A look inside</p>
    <h2 class="h-section">Warm, quiet, and honest about your day.</h2>

    <div class="shot-row shot-row--trio">
      <div class="shot-visual">
        <div class="shot-strip" tabindex="0" role="group" aria-label="Summary screens: day, week and month">
          <PhoneShot
            src={summaryDayShot}
            label="Day"
            alt="The Summary tab on Day: 665 calories eaten today, 1,835 left of a 2,500 budget, a breakdown of which meals it came from, and today's macros against goal."
            width={186}
          />
          <PhoneShot
            src={summaryShot}
            label="Week"
            alt="The Summary tab on Week: 2,207 calories eaten per day on average, under budget 3 of 4 days, a bar chart comparing calories eaten against the budget for each day, and macro averages against goal."
            width={186}
          />
          <PhoneShot
            src={summaryMonthShot}
            label="Month"
            alt="The Summary tab on Month: 2,398 calories eaten per day on average, under budget 6 of 8 days, a bar chart of each day's share of its budget with unlogged days shown as stubs, and macro averages against goal."
            width={186}
          />
        </div>
      </div>
      <div class="shot-copy">
        <h3 class="shot-title">Summary of your day/week/month</h3>
        <p class="shot-body">
          See your tracked calories and macros at a glance, with options to view your day, week, or month. The app shows you how your activity from Apple Health has raised your budget, and how your macros compare to your goals.
        </p>
        <ul class="shot-list">
          <li>Day, week, and month views</li>
          <li>Budget bars include the calories your activity earned</li>
          <li>Macro averages against your goal, over or under</li>
        </ul>
      </div>
    </div>

    <div class="shot-row shot-row-alt shot-row--duo">
      <div class="shot-visual">
        <div class="shot-strip" tabindex="0" role="group" aria-label="Adding food, and naming a meal">
          <PhoneShot
            src={addFoodShot}
            label="Six ways in"
            alt="The Add to Breakfast sheet: six cards for From Favorites, Recent foods, Enter manually, Describe or photograph, Scan a barcode, and Search foods."
            width={216}
          />
          <PhoneShot
            src={mealGroupShot}
            label="Name a meal"
            alt="A sheet titled Name this meal, with a meal name field, a Mark as favorite toggle, and a note explaining the selected foods collapse into one row you can expand and quick-add later."
            width={216}
          />
        </div>
      </div>
      <div class="shot-copy">
        <h3 class="shot-title">Add food however is fastest</h3>
        <p class="shot-body">
          Every way in sits on one screen. Pick a favorite, re-add something you
          ate recently, scan a barcode, search by name, type it yourself, or let
          AI read a photo. Eat the same four things together every morning? Group
          them into one named meal and add the whole thing next time.
        </p>
        <ul class="shot-list">
          <li>Favorites, recents, barcode, search, manual, or AI</li>
          <li>Group several foods into one named meal</li>
          <li>Mark a meal a favorite to quick-add it later</li>
        </ul>
      </div>
    </div>

    <div class="shot-row shot-row--duo">
      <div class="shot-visual">
        <div class="shot-strip" tabindex="0" role="group" aria-label="Choosing a theme colour, and the app using it">
          <PhoneShot
            src={themeSettingsShot}
            label="Pick a color"
            alt="The Appearance section of Settings in dark mode, set to Custom, with a primary colour swatch and preview chips showing protein, carbs, fat and ring as shades of green."
            width={216}
          />
          <PhoneShot
            src={themeTodayShot}
            label="The whole app follows"
            alt="The daily log in dark mode with a green theme: 1,835 calories left of 2,500, green calorie ring and macro bars, and a logged breakfast."
            width={216}
          />
        </div>
      </div>
      <div class="shot-copy">
        <h3 class="shot-title">Pick a color, the app follows</h3>
        <p class="shot-body">
          Settings has a Colorful preset, or you can choose your own primary
          color. The calorie ring, the buttons, and the macro bars all become
          shades of it. Dark mode is there too, and it looks good in both.
        </p>
        <ul class="shot-list">
          <li>Colorful preset, or any color you pick</li>
          <li>Ring, buttons, and macro bars all follow it</li>
          <li>Light and dark</li>
        </ul>
      </div>
    </div>

    <div class="shot-row shot-row-alt">
      <div class="shot-visual">
        <PhoneShot
          src={widgetsShot}
          alt="An iPhone Home Screen with two warm brown Calorie Cownter widgets: a medium one reading 1,947 calories left, 820 of 2,767 eaten, one meal logged, with a segmented macro bar and protein, carbs and fat totals; and a small one showing just the number left today."
          width={252}
        />
      </div>
      <div class="shot-copy">
        <h3 class="shot-title">Your day, one glance away</h3>
        <p class="shot-body">
          Put the number where you'll actually see it. The small widget is just
          calories left; the medium one spells out your macros.
        </p>
        <ul class="shot-list">
          <li>Small and medium Home Screen widgets</li>
          <!--<li>Lock Screen widgets, circular and rectangular</li>-->
          <li>Updates as you log — nothing to refresh</li>
        </ul>
      </div>
    </div>

    <div class="shot-row shot-row--pad">
      <div class="shot-visual">
        <PhoneShot
          src={ipadShot}
          device="pad"
          alt="Calorie Cownter on iPad: a side rail with Log, Summary and Settings, meals laid out in a grid as Breakfast, Lunch, Dinner and Snacks, and a card on the right showing 1,700 calories left with eaten, earned and budget totals plus macro bars."
          width={620}
        />
      </div>
      <div class="shot-copy">
        <h3 class="shot-title">Made for iPad, not stretched to it</h3>
        <p class="shot-body">
          On iPad your meals sit in a grid with the day's totals pinned next to
          them, and the tab bar becomes a side rail. Same diary, same iCloud,
          just more room to work with.
        </p>
        <ul class="shot-list">
          <li>Meals in a grid, totals always in view</li>
          <li>Side rail instead of a tab bar</li>
          <li>Picks up where your iPhone left off</li>
        </ul>
      </div>
    </div>
  </div>

  <!-- ============ PRIVACY ============ -->
  <div class="band-dark">
    <div class="section privacy">
      <p class="kicker kicker-on-dark">Private by design</p>
      <h2 class="h-section privacy-title">Your food diary is yours. We literally can't read it.</h2>
      <p class="privacy-lede">
        Calorie Cownter is built to keep your data private. Your diary lives in your iCloud, and your Health data never leaves your phone. We don't store or sell anything. Our goal is to make a great app, not to make money off your data.
      </p>
      <div class="privacy-grid">
        <div class="privacy-item">
          <h3 class="privacy-item-title">Your diary syncs in your iCloud</h3>
          <p class="privacy-item-body">Meals, goals, and favorites live in your private iCloud database. It's on your devices, not ours.</p>
        </div>
        <div class="privacy-item">
          <h3 class="privacy-item-title">Health data stays on your phone</h3>
          <p class="privacy-item-body">Activity is read on-device to work out your budget. Those numbers are never sent anywhere.</p>
        </div>
        <div class="privacy-item">
          <h3 class="privacy-item-title">Scanned photos are discarded</h3>
          <p class="privacy-item-body">A photo is analyzed to estimate nutrition and then thrown away. We don't keep it.</p>
        </div>
        <div class="privacy-item">
          <h3 class="privacy-item-title">No ads, no tracking</h3>
          <p class="privacy-item-body">No advertising, no analytics SDKs, nothing sold to anyone. There's no business model that needs it.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- ============ HOW IT WORKS ============ -->
  <div id="how" class="section">
    <p class="kicker">How it works</p>
    <h2 class="h-section h-narrower">Three steps. Zero spreadsheets.</h2>
    <div class="steps">
      <div class="step">
        <span class="step-num">01</span>
        <span class="step-title">Log your meals</span>
        <span class="step-body">Type it, scan the barcode, or snap a photo. Whichever is fastest wins.</span>
      </div>
      <div class="step">
        <span class="step-num">02</span>
        <span class="step-title">Earn calories back</span>
        <span class="step-body">A walk, a workout, a busy day — activity from Apple Health adds to your daily budget.</span>
      </div>
      <div class="step">
        <span class="step-num">03</span>
        <span class="step-title">Stay on budget</span>
        <span class="step-body">Watch the ring fill as your day goes. Macro bars keep you honest without the guilt trip.</span>
      </div>
    </div>
  </div>

  <!-- ============ FAQ ============ -->
  <div id="faq" class="band-soft">
    <div class="faq-wrap">
      <p class="kicker">FAQ</p>
      <h2 class="h-section faq-heading">Questions</h2>
      {faqs.map((f, i) => (
        <details name="faq" open={i === 0} class="faq-item">
          <summary>
            <span class="faq-q">{f.q}</span>
            <svg class="faq-ico faq-ico-minus" width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7h10" stroke="#664428" stroke-width="2.2" stroke-linecap="round"></path></svg>
            <svg class="faq-ico faq-ico-plus" width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M7 2v10M2 7h10" stroke="#8A7F6E" stroke-width="2.2" stroke-linecap="round"></path></svg>
          </summary>
          <p class="faq-a">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  /* ---------- HERO ---------- */
  .hero {
    max-width: var(--container);
    margin: 0 auto;
    padding: 44px var(--gutter) 96px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 56px;
  }
  .hero-copy { flex: 1 1 460px; min-width: 0; }
  .hero-kicker {
    margin: 0 0 22px;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--action);
  }
  .hero-title {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: clamp(46px, 6.5vw, 80px);
    line-height: 0.98;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .hero-title span { color: var(--action); }
  .hero-lede {
    margin: 24px 0 0;
    font-size: 19px;
    line-height: 1.6;
    color: var(--ink2);
    max-width: 46ch;
    text-wrap: pretty;
  }
  .hero-cta {
    margin-top: 34px;
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }
  .appstore {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    padding: 12px 26px;
    border-radius: 14px;
    line-height: 1.15;
    text-decoration: none;
  }
  .appstore-top { font-size: 11px; letter-spacing: 0.02em; }
  .appstore-bottom { font-family: var(--font-sans); font-weight: 800; font-size: 21px; }
  .appstore-live { background: var(--dark); color: #f4ede4; }
  .appstore-soon {
    background: var(--surface);
    color: var(--ink);
    border: 1.5px solid var(--rule);
    box-shadow: 0 1px 3px rgba(60, 45, 20, 0.06);
    cursor: default;
  }
  .appstore-soon .appstore-top { color: var(--muted); }
  .waitlist {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    background: var(--action);
    color: #fff;
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 17px;
    padding: 17px 28px;
    border-radius: 14px;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }
  .waitlist:hover {
    background: var(--deep);
    transform: translateY(-1px);
    box-shadow: 0 10px 26px rgba(102, 68, 40, 0.26);
  }
  .waitlist svg { flex: none; }
  .hero-note {
    margin: 14px 0 0;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 13px;
    color: var(--muted);
  }
  .hero-points {
    margin-top: 30px;
    display: flex;
    gap: 22px;
    flex-wrap: wrap;
    font-weight: 600;
    font-size: 14px;
    color: var(--ink2);
  }
  .hero-points span { display: inline-flex; align-items: center; gap: 7px; }

  .hero-visual {
    flex: 1 1 400px;
    display: flex;
    justify-content: center;
    position: relative;
    min-width: 300px;
  }
  .hero-halo {
    position: absolute;
    width: 380px;
    height: 380px;
    border-radius: 50%;
    background: var(--soft);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  /* ---------- SHARED SECTION PRIMITIVES ---------- */
  .band-soft { background: var(--soft); }
  .band-dark { background: var(--dark); color: var(--on-dark); }
  .section {
    max-width: var(--container);
    margin: 0 auto;
    padding: 96px var(--gutter);
  }
  .kicker {
    margin: 0 0 14px;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--action);
  }
  .kicker-on-dark { color: var(--tan); }
  .h-section {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: clamp(32px, 4.5vw, 48px);
    line-height: 1.06;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .h-narrow { max-width: 20ch; }
